#!/bin/bash
# This is the actual executable macOS launches when you double-click the
# "Sync From Chairish" app. It shows the whole thing as native macOS
# dialog boxes - a confirm button, then the result - and runs the sync
# invisibly in the background, no Terminal window involved at all.
LAUNCHER_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_DIR="$(cd "$LAUNCHER_DIR/../../.." && pwd)"
ICON="$LAUNCHER_DIR/../Resources/AppIcon.icns"
CORE="$APP_DIR/sync-chairish-core.sh"

confirm=$(osascript \
  -e 'display dialog "Sync new items from Chairish now?" with title "Michael Millard-Lowe Antiques" buttons {"Cancel", "Sync Now"} default button "Sync Now" with icon POSIX file "'"$ICON"'"' \
  -e 'button returned of result' 2>/dev/null)

if [ "$confirm" != "Sync Now" ]; then
  exit 0
fi

output="$(bash "$CORE" 2>&1)"

# The colorful ✓/↻/! report is designed for a real Terminal window, which
# understands the color codes it prints. This dialog box can't render
# those, so strip them out first - otherwise they show up as garbled
# "[32m" style text instead of just being invisible.
esc=$'\x1b'
output=$(printf '%s' "$output" | sed "s/${esc}\[[0-9;]*m//g")

# Escape backslashes and double quotes so the captured output can be
# safely embedded inside an AppleScript string literal.
escaped=$(printf '%s' "$output" | sed 's/\\/\\\\/g; s/"/\\"/g')

osascript \
  -e "display dialog \"$escaped\" with title \"Sync From Chairish\" buttons {\"OK\"} default button \"OK\" with icon POSIX file \"$ICON\"" \
  >/dev/null 2>&1
