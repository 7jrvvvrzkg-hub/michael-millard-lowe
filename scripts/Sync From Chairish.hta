<!DOCTYPE html>
<html>
<head>
<title>Sync From Chairish</title>
<hta:application
  id="oHTA"
  applicationname="Sync From Chairish"
  icon="MillardLoweSync.ico"
  border="thin"
  caption="yes"
  maximizebutton="no"
  minimizebutton="yes"
  sysmenu="yes"
  scroll="no"
  singleinstance="yes"
  windowstate="normal"
/>
<style>
  html, body {
    margin: 0; padding: 0; height: 100%;
    background: #faf3e9;
    font-family: Segoe UI, Tahoma, sans-serif;
    color: #3b2a1e;
    overflow: hidden;
  }
  #shell { display: flex; flex-direction: column; height: 100%; box-sizing: border-box; padding: 22px 26px; }
  #logo { display: block; margin: 0 auto 10px auto; width: 64px; height: 64px; }
  h1 { text-align: center; font-size: 15px; font-weight: 600; margin: 0 0 2px 0; letter-spacing: .2px; }
  #sub { text-align: center; font-size: 11px; color: #8a7360; margin: 0 0 16px 0; }
  #syncBtn {
    display: block; margin: 0 auto 14px auto;
    background: #c2541b; color: #fff; border: none; border-radius: 8px;
    font-size: 13px; font-weight: 600; padding: 10px 26px; cursor: pointer;
  }
  #syncBtn:disabled { background: #d8a685; cursor: default; }
  #syncBtn:hover:enabled { background: #a8481700; background: #ab4718; }
  #output {
    flex: 1; background: #fff; border: 1px solid #e6dbca; border-radius: 8px;
    padding: 10px 12px; font-family: Consolas, monospace; font-size: 11px;
    white-space: pre-wrap; overflow-y: auto; color: #3b2a1e; line-height: 1.5;
  }
  #footer { margin-top: 12px; text-align: center; }
  #pinBtn {
    background: none; border: 1px solid #d8c9ae; color: #8a7360; border-radius: 6px;
    font-size: 11px; padding: 5px 12px; cursor: pointer;
  }
  #pinBtn:hover { background: #f1e7d4; }
  #pinNote { font-size: 10px; color: #8a7360; margin-top: 6px; }
</style>
</head>
<body>
<div id="shell">
  <img id="logo" src="data:image/png;base64," />
  <h1>Michael Millard-Lowe Antiques</h1>
  <div id="sub">Sync new items from Chairish</div>
  <button id="syncBtn" onclick="runSync()">Sync Now</button>
  <div id="output">Click "Sync Now" to check Chairish for new or updated listings.</div>
  <div id="footer">
    <button id="pinBtn" onclick="pinToDesktop()">Add icon to Desktop (for pinning to taskbar)</button>
    <div id="pinNote"></div>
  </div>
</div>

<script language="JScript">

function getScriptDir() {
  // location.pathname on an HTA gives a URL-encoded, forward-slash path
  // like "/C:/Users/you/Desktop/antique-shop/scripts/Sync%20From...hta".
  // Convert that back into a normal Windows folder path.
  var p = unescape(location.pathname);
  if (p.charAt(0) === "/") { p = p.substring(1); }
  p = p.replace(/\//g, "\\");
  var lastSlash = p.lastIndexOf("\\");
  return p.substring(0, lastSlash);
}

function getScriptPath() {
  var p = unescape(location.pathname);
  if (p.charAt(0) === "/") { p = p.substring(1); }
  p = p.replace(/\//g, "\\");
  return p;
}

function setOutput(text) {
  document.getElementById("output").innerText = text;
}

function runSync() {
  var btn = document.getElementById("syncBtn");
  btn.disabled = true;
  btn.innerText = "Syncing...";
  setOutput("Working - this can take a little while the first time...");

  try {
    var shell = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var scriptDir = getScriptDir();
    var tmpFile = scriptDir + "\\.sync-output.tmp";
    var comspec = shell.ExpandEnvironmentStrings("%comspec%");

    // Redirect all output to a temp file and run fully hidden (windowStyle
    // 0) so no console window ever flashes on screen - the result gets
    // read back in and shown right here in the app's own window instead.
    var cmd = '"' + comspec + '" /c call "' + scriptDir + '\\sync-chairish-core.bat" > "' + tmpFile + '" 2>&1';
    shell.Run(cmd, 0, true);

    var resultText = "(no output)";
    if (fso.FileExists(tmpFile)) {
      var stream = fso.OpenTextFile(tmpFile, 1);
      resultText = stream.AtEndOfStream ? "(no output)" : stream.ReadAll();
      stream.Close();
      try { fso.DeleteFile(tmpFile); } catch (eDel) {}
    }
    setOutput(resultText);
  } catch (e) {
    setOutput("Something went wrong running the sync:\n" + e.description);
  }

  btn.disabled = false;
  btn.innerText = "Sync Now";
}

function pinToDesktop() {
  var note = document.getElementById("pinNote");
  try {
    var shell = new ActiveXObject("WScript.Shell");
    var scriptDir = getScriptDir();
    var htaPath = getScriptPath();
    var desktop = shell.SpecialFolders("Desktop");

    var shortcut = shell.CreateShortcut(desktop + "\\Sync From Chairish.lnk");
    shortcut.TargetPath = "mshta.exe";
    shortcut.Arguments = '"' + htaPath + '"';
    shortcut.IconLocation = scriptDir + "\\MillardLoweSync.ico";
    shortcut.WorkingDirectory = scriptDir;
    shortcut.Description = "Sync new items from Chairish";
    shortcut.Save();

    note.innerText = "Added! Right-click it on your Desktop and choose \"Pin to taskbar\" or \"Pin to Start.\"";
  } catch (e) {
    note.innerText = "Couldn't add the icon: " + e.description;
  }
}

window.resizeTo(420, 480);
</script>
</body>
</html>
